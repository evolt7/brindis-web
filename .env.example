# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, estas mismas variables van en Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La "anon key" o la "publishable key" (empieza con sb_publishable_). Es pública, no es secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-PUBLICA

# La dirección final de la web, sin barra al final
NEXT_PUBLIC_SITE_URL=https://www.brindis.fun
